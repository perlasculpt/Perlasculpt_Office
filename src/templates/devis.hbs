<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Devis {{numeroFacture}} — {{clinic.name}}</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  @page { size: A4; margin: 0; }

  :root {
    --bordeaux: #4A111C;
    --creme:    #F3E8DE;
    --rose:     #C9A6A5;
    --dore:     #B08D57;
    --blanc:    #FFF9F5;
    --texte:    #5A5A5A;
    --radius:   8px;
    --serif: 'Playfair Display', Georgia, serif;
    --sans:  'Plus Jakarta Sans', Arial, sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--blanc);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  body {
    font-family: var(--sans);
    font-size: 8px;
    line-height: 1.4;
    color: var(--texte);
  }

  /* ---------- Page A4 fixe ---------- */
  .page {
    width: 210mm;
    min-height: 296mm;
    margin: 0 auto;
    padding: 16px 20px;
    background: var(--blanc);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ---------- HEADER 3 COLONNES ---------- */
  .header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--bordeaux);
  }

  .header-left { text-align: left; }

  .brand-name {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--bordeaux);
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .brand-info {
    font-size: 7.5px;
    line-height: 1.45;
    color: var(--texte);
  }

  .header-center { text-align: center; }

  .logo-box {
    width: 65px;
    height: 65px;
    border: 1.5px solid var(--dore);
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    background: var(--creme);
  }
  .logo-letter {
    font-family: var(--serif);
    font-size: 26px;
    color: var(--bordeaux);
    font-weight: 700;
    line-height: 1;
  }
  .logo-sub {
    font-size: 6px;
    letter-spacing: 0.12em;
    color: var(--dore);
    font-weight: 700;
    text-transform: uppercase;
  }

  .header-right { text-align: right; }

  .doc-title {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 700;
    color: var(--bordeaux);
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .meta-list {
    margin-top: 6px;
    display: grid;
    gap: 2px;
    justify-items: end;
  }

  .meta-row { display: flex; gap: 8px; font-size: 8px; }
  .meta-row dt { color: var(--texte); }
  .meta-row dd { color: var(--bordeaux); font-weight: 700; }

  /* ---------- Cartes ---------- */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }

  .card {
    background: var(--creme);
    border: 1px solid var(--rose);
    border-radius: var(--radius);
    padding: 7px 10px;
  }

  .card-title {
    font-family: var(--serif);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--bordeaux);
    padding-bottom: 4px;
    margin-bottom: 5px;
    border-bottom: 1px solid var(--rose);
  }

  .info-list { display: grid; gap: 2px; }
  .info-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 6px;
    font-size: 8px;
  }
  .info-row dt { color: var(--texte); }
  .info-row dd { color: var(--bordeaux); font-weight: 600; }

  /* ---------- Section title ---------- */
  .section-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 2px 0 4px;
    font-family: var(--serif);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--bordeaux);
  }
  .section-title::before {
    content: "";
    width: 14px;
    height: 2px;
    background: var(--rose);
  }

  /* ---------- Tableaux ---------- */
  .table-wrap {
    border: 1px solid var(--rose);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--blanc);
  }

  table { width: 100%; border-collapse: collapse; table-layout: fixed; }

  thead th {
    background: var(--bordeaux);
    color: #fff;
    font-weight: 600;
    font-size: 7.5px;
    padding: 4px 8px;
    text-align: right;
    letter-spacing: .04em;
  }
  thead th:first-child { text-align: left; }
  thead th.c-center { text-align: center; }

  tbody td {
    padding: 3px 8px;
    text-align: right;
    vertical-align: top;
    color: var(--texte);
    font-size: 7.5px;
  }
  tbody td:first-child { text-align: left; }
  tbody td.c-center { text-align: center; }
  tbody tr:nth-child(even) td { background: var(--creme); }

  .amount { font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.c-total { color: var(--bordeaux); font-weight: 700; }

  .badge {
    display: inline-block;
    padding: 1px 7px;
    border: 1px solid var(--rose);
    border-radius: 999px;
    font-size: 7px;
    font-weight: 600;
    color: var(--bordeaux);
    background: var(--blanc);
  }
  .badge-offert {
    background: var(--bordeaux);
    color: #fff;
    border-color: var(--bordeaux);
  }

  /* ---------- Totaux ---------- */
  .finance-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    align-items: start;
  }

  .card-plain {
    background: var(--blanc);
    border: 1px solid var(--rose);
    border-radius: var(--radius);
    padding: 7px 10px;
  }

  .totals { display: grid; gap: 3px; }
  .total-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 8px;
  }
  .total-row span:last-child {
    color: var(--bordeaux);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .total-row.ttc {
    padding-top: 4px;
    border-top: 1px dashed var(--rose);
  }
  .total-row.ttc span:first-child { color: var(--bordeaux); font-weight: 700; }

  .total-row.solde {
    margin-top: 3px;
    padding-top: 5px;
    border-top: 2px solid var(--bordeaux);
    font-size: 10px;
  }
  .total-row.solde span:first-child {
    font-family: var(--serif);
    font-weight: 700;
    color: var(--bordeaux);
  }
  .total-row.solde span:last-child {
    font-family: var(--serif);
    font-size: 12px;
    font-weight: 700;
    color: var(--bordeaux);
  }

  .lettres {
    margin-top: 5px;
    font-size: 7px;
    font-style: italic;
    line-height: 1.4;
    color: var(--texte);
    padding: 4px 7px;
    background: var(--creme);
    border-left: 3px solid var(--rose);
    border-radius: 4px;
  }
  .lettres strong { color: var(--bordeaux); font-style: normal; }

  /* ---------- Footer ---------- */
  .footer {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .legal {
    font-size: 6.5px;
    line-height: 1.4;
    text-align: justify;
    color: var(--texte);
  }
  .legal strong { color: var(--bordeaux); }

  .foot-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 7px;
    letter-spacing: .15em;
    color: var(--bordeaux);
    padding-top: 5px;
    border-top: 1px solid var(--rose);
  }

  @media print {
    html, body { background: var(--blanc); width: 210mm; }
    .page { margin: 0; box-shadow: none; }
  }
</style>
</head>
<body>
<div class="page">

  <!-- ================= HEADER ================= -->
  <header class="header">
    <div class="header-left">
      <div class="brand-name">{{clinic.name}}</div>
      <div class="brand-info">
        {{clinic.address}}<br>
        Tél : {{clinic.phone}}<br>
        MF : {{clinic.mf}}<br>
        Identifiant : {{clinic.identifiant}}
      </div>
    </div>

    <div class="header-center">
      <div class="logo-box">
        <span class="logo-letter">P</span>
        <span class="logo-sub">Perla</span>
      </div>
    </div>

    <div class="header-right">
      <h1 class="doc-title">Devis</h1>
      <dl class="meta-list">
        <div class="meta-row"><dt>Réf :</dt><dd>{{numeroFacture}}</dd></div>
        <div class="meta-row"><dt>Date édition :</dt><dd>{{dateEmission}}</dd></div>
        <div class="meta-row"><dt>Acte prévu :</dt><dd>{{actePrincipal}}</dd></div>
      </dl>
    </div>
  </header>

  <!-- ================= PATIENTE ================= -->
  <section>
    <h2 class="section-title">Informations patiente</h2>
    <article class="card">
      <dl class="info-list">
        <div class="info-row"><dt>Nom &amp; Prénom</dt><dd>{{patient.nomPrenom}}</dd></div>
        <div class="info-row"><dt>N° Passeport / CIN</dt><dd>{{patient.passeport}}</dd></div>
        <div class="info-row"><dt>Téléphone</dt><dd>{{patient.telephone}}</dd></div>
        <div class="info-row"><dt>Nationalité &amp; Pays</dt><dd>{{patient.nationalite}} ({{patient.paysResidence}})</dd></div>
      </dl>
    </article>
  </section>

  <!-- ================= PRESTATIONS & ACTES ================= -->
  <section>
    <h2 class="section-title">Prestations médicales &amp; chirurgicales</h2>
    <div class="table-wrap">
      <table>
        <colgroup>
          <col style="width:45%"><col style="width:15%"><col style="width:20%"><col style="width:20%">
        </colgroup>
        <thead>
          <tr>
            <th>Désignation</th>
            <th class="c-center">Quantité</th>
            <th>Prix unitaire (TND)</th>
            <th>Total (TND)</th>
          </tr>
        </thead>
        <tbody>
          {{#each prestations}}
          <tr>
            <td>{{this.designation}}</td>
            <td class="c-center">{{this.quantite}}</td>
            <td class="amount">{{this.prixUnitaireFormatted}}</td>
            <td class="amount c-total">{{this.totalLigneFormatted}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ================= COMPTE D'AUTRUI / CHARGES ================= -->
  {{#if hasCharges}}
  <section>
    <h2 class="section-title">Logistique &amp; prise en charge (Clinique / Séjour / Bloc)</h2>
    <div class="table-wrap">
      <table>
        <colgroup>
          <col style="width:25%"><col style="width:45%"><col style="width:30%">
        </colgroup>
        <thead>
          <tr>
            <th>Catégorie</th>
            <th>Détail / Description</th>
            <th>Montant (TND)</th>
          </tr>
        </thead>
        <tbody>
          {{#each charges}}
          <tr>
            <td>{{this.categorie}}</td>
            <td>{{this.description}}</td>
            <td class="amount c-total">{{this.montantFormatted}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  {{/if}}

  <!-- ================= RÉCAPITULATIF ================= -->
  <section class="finance-grid">
    <div class="card-plain">
      <h2 class="card-title">Modalités &amp; Acompte</h2>
      <div class="totals">
        <div class="total-row"><span>Acte principal</span><span>{{actePrincipal}}</span></div>
        <div class="total-row"><span>Acompte requis</span><span>{{acompteFormatted}} TND</span></div>
      </div>
      <div class="lettres">
        <strong>Net à payer en lettres :</strong>
        {{montantEnLettres}} dinars tunisiens.
      </div>
    </div>

    <div class="card">
      <h2 class="card-title">Récapitulatif financier</h2>
      <div class="totals">
        <div class="total-row"><span>Total HT</span><span>{{totalHTFormatted}} TND</span></div>
        <div class="total-row"><span>TVA (0 %)</span><span>0,000 TND</span></div>
        <div class="total-row ttc"><span>Total TTC</span><span>{{totalTTCFormatted}} TND</span></div>
        <div class="total-row"><span>Acompte convenu</span><span>{{acompteFormatted}} TND</span></div>
        <div class="total-row solde"><span>Solde restant</span><span>{{soldeRestantFormatted}} TND</span></div>
      </div>
    </div>
  </section>

  <!-- ================= FOOTER ================= -->
  <footer class="footer">
    <p class="legal">
      <strong>Document non contractuel valable 30 jours.</strong>
      Devis édité le <strong>{{dateEmission}}</strong> par <strong>{{clinic.name}}</strong>.
      MF : {{clinic.mf}} — Les Berges du Lac 2, Tunis.
    </p>

    <div class="foot-bar">
      <span>★ {{clinic.name}} &nbsp;·&nbsp; {{clinic.address}} &nbsp;·&nbsp; TÉL : {{clinic.phone}} ★</span>
    </div>
  </footer>

</div>
</body>
</html>
